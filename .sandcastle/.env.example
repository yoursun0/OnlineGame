# Grok / xAI — required inside Docker sandboxes and CI without `grok login`.
# On the Cloud host, `grok login` (~/.grok/auth.json) is enough for noSandbox.
XAI_API_KEY=

# Optional model override (default: grok-4.6)
# GROK_MODEL=grok-4.6

# GitHub token for `gh` inside the sandbox (Issues read/write).
# On the Cloud host, `gh auth` may already be configured for noSandbox.
GH_TOKEN=
# GITHUB_TOKEN=

# Sandbox selector for main.mts: none (default, Cloud) | docker
SANDCASTLE_SANDBOX=none

# Optional Docker image name when SANDCASTLE_SANDBOX=docker
# SANDCASTLE_IMAGE_NAME=sandcastle:onlinegame

# Max AFK iterations per process (default 1 for safe smoke runs)
# SANDCASTLE_MAX_ITERATIONS=1
